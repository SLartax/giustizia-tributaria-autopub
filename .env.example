# Banca dati Giustizia Tributaria
GT_BASE_URL=https://bancadatigiurisprudenza.giustiziatributaria.gov.it/
GT_SEARCH_PATH=ricerca
GT_MAX_ITEMS_PER_RUN=15
GT_MAX_PUBLISH_PER_RUN=3
GT_SLEEP_BETWEEN_ITEMS=2.5
GT_SLEEP_JITTER_MAX=1.2
GT_HEADLESS=true
GT_NAV_TIMEOUT_MS=45000
GT_DISCLAIMER=Il presente contenuto ha finalità esclusivamente informative...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

